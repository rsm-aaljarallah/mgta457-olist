            "height": 1
          }
        },
        {
          "widget": {
            "name": "w_routes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "routes",
                  "fields": [
                    {
                      "name": "excess_rank",
                      "expression": "`excess_rank`"
                    },
                    {
                      "name": "route",
                      "expression": "`route`"
                    },
                    {
                      "name": "orders",
                      "expression": "`orders`"
                    },
                    {
                      "name": "broken_pct",
                      "expression": "`broken_pct`"
                    },
                    {
                      "name": "margin_pts",
                      "expression": "`margin_pts`"
                    },
                    {
                      "name": "excess_broken",
                      "expression": "`excess_broken`"
                    },
                    {
                      "name": "fix_type",
                      "expression": "`fix_type`"
                    },
                    {
                      "name": "first_step",
                      "expression": "`first_step`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "rowsPerPage": 10,
              "displayRowNumbers": false,
              "data": {
                "queryName": "main_query"
              },
              "encodings": {
                "columns": [
                  {
                    "fieldName": "excess_rank",
                    "displayName": "Rank",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    },
                    "format": {
                      "type": "numeral.js",
                      "format": "0,0"
                    }
                  },
                  {
                    "fieldName": "route",
                    "displayName": "Route",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    }
                  },
                  {
                    "fieldName": "orders",
                    "displayName": "Orders",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    },
                    "format": {
                      "type": "numeral.js",
                      "format": "0,0"
                    }
                  },
                  {
                    "fieldName": "broken_pct",
                    "displayName": "Broken %",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    },
                    "format": {
                      "type": "numeral.js",
                      "format": "0.0"
                    }
                  },
                  {
                    "fieldName": "margin_pts",
                    "displayName": "+/- points",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    }
                  },
                  {
                    "fieldName": "excess_broken",
                    "displayName": "Excess broken",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    },
                    "format": {
                      "type": "numeral.js",
                      "format": "0,0"
                    }
                  },
                  {
                    "fieldName": "fix_type",
                    "displayName": "Fix type",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    },
                    "style": {
                      "type": "basic",
                      "rules": [
                        {
                          "condition": {
                            "operand": {
                              "type": "data-value",
                              "value": "Both"
                            },
                            "operator": "="
                          },
                          "foregroundColor": "#FF3621"
                        },
                        {
                          "condition": {
                            "operand": {
                              "type": "data-value",
                              "value": "Lasting fix"
                            },
                            "operator": "="
                          },
                          "foregroundColor": "#FFAB00"
                        },
                        {
                          "condition": {
                            "operand": {
                              "type": "data-value",
                              "value": "Busy-season plan"
                            },
                            "operator": "="
                          },
                          "foregroundColor": "#3A7DC9"
                        },
                        {
                          "condition": {
                            "operand": {
                              "type": "data-value",
                              "value": "Watch"
                            },
                            "operator": "="
                          },
                          "foregroundColor": "#919191"
                        }
                      ]
                    }
                  },
                  {
                    "fieldName": "first_step",
                    "displayName": "First step",
                    "useForSearch": false,
                    "actions": {
                      "hover": {
                        "type": "tooltip",
                        "tooltipTemplate": "{{ @ }}"
                      }
                    }
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Routes to fix first",
                "showDescription": true,
                "description": "Ranked by excess broken promises: broken minus what the national rate (8.7%) predicts for the route's orders. A route with fewer than 100 orders gets no fix type (Watch) and no margin (shown as \u2013). The fix type compares busy months with the rest of the year, so this table ignores the month filter."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 6,
            "height": 8
          }
        },
        {
          "widget": {
            "name": "w_line",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "metrics",
                  "fields": [
                    {
                      "name": "purchase_month",
                      "expression": "`purchase_month`"
                    },
                    {
                      "name": "measure(broken_rate)",
                      "expression": "MEASURE(`broken_rate`)"
                    },
                    {
                      "name": "customer_area",
                      "expression": "`customer_area`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "purchase_month",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Purchase month",
                  "axis": {
                    "title": "Purchase month"
                  }
                },
                "y": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "axis": {
                    "title": "Broken-promise rate"
                  },
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  },
                  "fieldName": "measure(broken_rate)",
                  "displayName": "Broken-promise rate"
                },
                "color": {
                  "fieldName": "customer_area",
                  "displayName": "Customer area",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Broken-promise rate by month and area",
                "showDescription": true,
                "description": "Busy months: Nov 2017, Feb 2018 and Mar 2018, when the national rate was at least twice the median month. The Northeast breaks promises in ordinary months too. August 2018 is a partial month: about 30% of its orders were promised for September and are not judged."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 11,
            "width": 3,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "w_later",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "metrics",
                  "fields": [
                    {
                      "name": "customer_region",
                      "expression": "`customer_region`"
                    },
                    {
                      "name": "measure(broken_rate)",
                      "expression": "MEASURE(`broken_rate`)"
                    },
                    {
                      "name": "measure(broken_rate_if_3_days_later)",
                      "expression": "MEASURE(`broken_rate_if_3_days_later`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "customer_region",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "y-reversed"
                    }
                  },
                  "displayName": "Customer region",
                  "axis": {
                    "title": "Customer region"
                  }
                },
                "y": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "axis": {
                    "title": "Broken-promise rate"
                  },
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  },
                  "fields": [
                    {
                      "fieldName": "measure(broken_rate)",
                      "displayName": "Now"
                    },
                    {
                      "fieldName": "measure(broken_rate_if_3_days_later)",
                      "displayName": "Promise 3 days later"
                    }
                  ]
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Now vs a promise 3 days later, by region",
                "showDescription": true,
                "description": "With no filter: promising later fixes less than a quarter of the problem, and less in the Northeast, where a late order typically arrives 8 days late."
              },
              "mark": {
                "layout": "group"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 11,
            "width": 3,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "w_days",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "metrics",
                  "fields": [
                    {
                      "name": "promise_outcome",
                      "expression": "`promise_outcome`"
                    },
                    {
                      "name": "measure(avg_days_to_carrier)",
                      "expression": "MEASURE(`avg_days_to_carrier`)"
                    },
                    {
                      "name": "measure(avg_days_carrier_to_customer)",
                      "expression": "MEASURE(`avg_days_carrier_to_customer`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "promise_outcome",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Promise",
                  "axis": {
                    "title": "Promise"
                  }
                },
                "y": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "axis": {
                    "title": "Average days"
                  },
                  "format": {
                    "type": "number-plain",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  },
                  "fields": [
                    {
                      "fieldName": "measure(avg_days_to_carrier)",
                      "displayName": "Purchase to carrier"
                    },
                    {
                      "fieldName": "measure(avg_days_carrier_to_customer)",
                      "displayName": "Carrier to customer"
                    }
                  ]
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Where the days go: purchase to carrier, carrier to customer",
                "showDescription": true,
                "description": "Judged orders that arrived, both parts measured on the same orders, so each bar adds up to the delivery time. Most of a broken promise's delay comes after the handover."
              },
              "mark": {
                "layout": "stack"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 17,
            "width": 4,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "w_handed",
