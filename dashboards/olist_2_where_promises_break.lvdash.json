            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "seller_state",
                    "displayName": "seller_state",
                    "queryName": "filter_w_f_seller_metrics_seller_state"
                  },
                  {
                    "fieldName": "seller_state",
                    "displayName": "seller_state",
                    "queryName": "filter_w_f_seller_routes_seller_state"
                  }
                ]
              },
              "frame": {
