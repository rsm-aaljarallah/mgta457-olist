{
  "datasets": [
    {
      "name": "metrics",
      "displayName": "delivery_metrics",
      "asset_name": "olist.analytics.delivery_metrics"
    },
    {
      "name": "routes",
      "displayName": "routes",
      "queryLines": [
        "SELECT * FROM olist.analytics.route_list ORDER BY excess_rank"
      ]
    },
    {
      "name": "checks",
      "displayName": "checks",
      "queryLines": [
        "SELECT * FROM olist.analytics.pipeline_checks ORDER BY check_no"
      ]
    },
    {
      "name": "rules",
      "displayName": "rules",
      "queryLines": [
        "SELECT * FROM olist.analytics.silver_rule_counts ORDER BY rule_no"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "quarantine",
      "queryLines": [
        "SELECT * FROM olist.analytics.quarantine_summary"
      ]
    },
    {
      "name": "deliveries",
      "displayName": "deliveries",
      "queryLines": [
        "SELECT * FROM olist.analytics.deliveries_per_month ORDER BY delivery_month"
      ]
    },
    {
      "name": "fairness",
      "displayName": "fairness",
      "queryLines": [
        "SELECT * FROM olist.analytics.region_fairness ORDER BY broken_pct DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "page1",
      "displayName": "Where promises break",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "w_title",
            "multilineTextboxSpec": {
              "lines": [
                "# Where promises break\n",
                "For the Head of Logistics: which routes to fix first, and whether each needs a lasting fix, a busy-season plan, or both. A route is seller state > customer state, for orders shipped by one seller."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "w_f_month",
            "queries": [
              {
                "name": "filter_w_f_month_metrics_purchase_month",
                "query": {
                  "datasetName": "metrics",
                  "disaggregated": false,
                  "fields": [
                    {
                      "name": "purchase_month",
                      "expression": "`purchase_month`"
                    },
                    {
                      "name": "purchase_month_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "purchase_month",
                    "displayName": "purchase_month",
                    "queryName": "filter_w_f_month_metrics_purchase_month"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Purchase month"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "w_f_seller",
